def ethylene_model(v,y,T,P):  # y is a vector of molar flow rates [F_A, F_B, F_C]
        F_A=y[0]
        F_B=y[1]
        F_C=y[2]
 
        k_ref=0.072 # is the (refererence) rate at 1000K (Reference temperature=T_ref=1000K)
        T_ref=1000 #Kelvin
        R=8.314 # J/mol-K

        k=k_ref*np.exp(a/R*(1/T_ref-1/T)) # Arrhenius equation for rate constant

        F_tot1=F_A+F_B+F_C
        C_tot1=P/(R*T)
        
        Ci=C_tot1*(y/F_tot1)*(P/P0)*(T0/T) # concentration of each species using ideal gas law

        y_A=F_A/F_tot1
        y_B=F_B/F_tot1
        y_C=F_C/F_tot1

        C_A=Ci[0]
        C_B=Ci[1]
        C_C=Ci[2]

        r_A=-k*C_A
        r_B=-r_A
        r_C=-r_A
        
        dF_A_dv=r_A
        dF_B_dv=r_B
        dF_C_dv=r_C

        return [dF_A_dv,dF_B_dv,dF_C_dv]

