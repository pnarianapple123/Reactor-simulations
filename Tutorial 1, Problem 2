def ethylene_model(v,z,T,P):  # z is a vector of molar flow rates [F_A, F_B, F_C]
        F_A=z[0]
        F_B=z[1]
        F_C=z[2]
 
        r_ref=0.072 # is the (refererence) rate at 1000K (Reference temperature=T_ref=1000K)
        T_ref=1000 #Kelvin
        R=8.314 # J/mol-K


        k=r_ref*np.exp(a/R*(1/T_ref-1/T)) # Arrhenius equation for rate constant

        F_tot=F_A+F_B+F_C
        C_tot=P/(R*T)
        
        Ci=C_tot*(z/F_tot)*(P/P0)*(T0/T) # concentration of each species using ideal gas law

        y_A=F_A/F_tot
        y_B=F_B/F_tot
        y_C=F_C/F_tot

        C_A=C_tot*(y_A)
        C_B=C_tot*(y_B)
        C_C=C_tot*(y_C)

        r_B=-r_A
        r_C=-r_A
        r_A=-k*C_A

        dF_A_dv=-r_A
        dF_B_dv=r_B
        dF_C_dv=r_C


        return [dF_A_dv,dF_B_dv,dF_C_dv]

