# Ethylene production using an isothermal PFR


from scipy.integrate import solve_ivp
import numpy as np
import matplotlib.pyplot as plt

def ethylene_model(v,y,T,P):  # y is a vector of molar flow rates [F_A, F_B, F_C]
        F_A=y[0]
        F_B=y[1]
        F_C=y[2]

        a=343.3e3
        k_ref=0.072 # is the (refererence) rate at 1000K (Reference temperature=T_ref=1000K)
        T_ref=1000 #Kelvin
        R=8.314 # J/mol-K

        k=k_ref*np.exp(a/R*(1/T_ref-1/T)) # Arrhenius equation for rate constant

        F_tot1=F_A+F_B+F_C
        C_tot1=P/(R*T)
        
        Ci=C_tot1*(y/F_tot1) # concentration of each species using ideal gas law

        C_A=Ci[0]
        C_B=Ci[1]
        C_C=Ci[2]

        r_A=-k*C_A
        r_B=-r_A
        r_C=-r_A
        
        dF_A_dv=r_A
        dF_B_dv=r_B
        dF_C_dv=r_C

        return [dF_A_dv,dF_B_dv,dF_C_dv]

X=0.8

P0=608e3 # pressure in kPa
T0=1100 #Kelvin

max_vol = 3
volume_span = (0,max_vol)
vol_steps = 500
volume_array = np.linspace(0,max_vol,vol_steps)

# Initial conditions for the molar flow rates 
F_0 = [192.5,0,0]

# Solve mass balance by integrating the differential equation
solution = solve_ivp(ethylene_model,t_span=volume_span,y0=F_0,t_eval=volume_array,args=(T0,P0))

vol = solution.t
FA = solution.y[0,:]
FB = solution.y[1,:]   
FC = solution.y[2,:]

F_tot=FA+FB+FC
FA0=F_0[0]
X=1-FA/FA0
yi=solution.y/F_tot # y is the mole fraction of each species

print('    {0:12} {1:12} {2:14} {3:12} {4:12} {5:12} {6:12} {7:12} {8:12}'.format('Volume','Conversion','F_A', 'F_B', 'F_C', 'F_tot', 'yi_A', 'yi_B', 'yi_C'))
for i in range(vol_steps):
    print('{0:12.6f} {1:12.6f}  {2:12.6f}  {3:12.6f}  {4:12.6f}  {5:12.6f}  {6:12.6f}  {7:12.6f}  {8:12.6f}'.format(
        vol[i],
        X[i], 
        FA[i],
        FB[i],
        FC[i],
        F_tot[i],
        yi[0,i],
        yi[1,i],
        yi[2,i]))

x_target=0.8
x_diff=np.abs(X-x_target)
target_index=np.argmin(x_diff)
V_actual=vol[target_index]
F_A_actual=FA[target_index]
F_B_actual=FB[target_index]
F_C_actual=FC[target_index]
F_tot_actual=F_A_actual+F_B_actual+F_C_actual
yi_A_actual=F_A_actual/F_tot_actual
yi_B_actual=F_B_actual/F_tot_actual
yi_C_actual=F_C_actual/F_tot_actual

print('At the conversion  X={0:7.6f}, the properties are:'.format(x_target))
print('      - vol = {0:7.6f}'.format(V_actual))
print('      - F_A = {0:7.6f}'.format(F_A_actual))
print('      - F_B = {0:7.6f}'.format(F_B_actual))
print('      - F_C = {0:7.6f}'.format(F_C_actual))
print('      - y_A = {0:7.6f}'.format(yi_A_actual))
print('      - y_B = {0:7.6f}'.format(yi_B_actual))
print('      - y_C = {0:7.6f}'.format(yi_C_actual))

# Create a plot object. The size is in inches
fig=plt.figure(figsize=(10,4))

# Create two subplots in the figure. 
ax1 = fig.add_subplot(1, 2, 1)
ax2 = fig.add_subplot(1, 2, 2)


plt.subplots_adjust(wspace=0.3,hspace=0) # This adjust the spacing between plots

# Plot the molar flow rates
# ax1.plot(solution.t,F_tot, '-k',label=r'$F_\mathrm{tot}$')
# ax1.plot(solution.t,solution.y[0], '--b',label=r'$F_\mathrm{A}$')
# ax1.plot(solution.t,solution.y[1], '--r',label=r'$F_\mathrm{B}$')
# ax1.plot(solution.t,solution.y[2], '--g',label=r'$F_\mathrm{C}$')
ax1.plot(vol,F_tot, '-k',label='FT')
ax1.plot(vol,FA, '--b',label='FA')
ax1.plot(vol,FB, '--r',label='FB')
ax1.plot(vol,FC, '--g',label='FC')
ax1.set_xlabel('volume')
ax1.set_ylabel('molar flow rate')
ax1.set_xlim([0,3])
ax1.set_ylim([0,400])
ax1.legend()

# Plot conversion
ax2.plot(vol,X,'-k',label=r'$X$')
# Indicate the reactor volume to achieve the target conversion
ax2.plot([V_actual,V_actual],[0,x_target],':k')
ax2.plot([0,V_actual],[x_target,x_target],':k')
# Plot the mole fractions of A, B, and C
ax2.plot(vol,yi[0,:],'--b',label='yA')
ax2.plot(vol,yi[1,:],'--g',label='yB')
ax2.plot(vol,yi[2,:],'--r',label='yC')
ax2.set_xlabel('volume')
ax2.set_ylabel('mole fraction')
ax2.legend()


# Save figure 
plt.savefig("ethylene.pdf")
# Display figure
plt.show()